# Project Memory MCP — environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# --------------------------------------------------------------------------
# HTTP Bearer token auth (required when using --transport http for internet exposure)
# --------------------------------------------------------------------------
# Set AUTH_TOKEN to enable Bearer token auth on the HTTP transport.
# Use a long random string — e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty (or unset) to disable auth (local/stdio use only).
AUTH_TOKEN=your-secret-token-here
